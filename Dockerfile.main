# Dockerfile.main
# Builds the main.py FastAPI service (port 8000)
# Build:  docker build -f Dockerfile.main -t rag-main .
# Run:    docker run -p 8000:8000 -e ANTHROPIC_API_KEY=sk-ant-... -e VECTORDB_URL=http://host.docker.internal:8001 rag-main

FROM python:3.12-slim

# Prevents .pyc files and enables stdout/stderr logging
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install dependencies first (better layer caching)
COPY requirements.main.txt .
RUN pip install --no-cache-dir -r requirements.main.txt

# Copy only the source files needed for main.py
COPY main.py orchestrator.py retriever.py reasoner.py validator.py ./

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
