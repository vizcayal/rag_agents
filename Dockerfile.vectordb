# Dockerfile.vectordb
# Builds the ChromaDB VectorDB service
# Build: docker build -f Dockerfile.vectordb -t rag-vectordb .

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install dependencies (ensure chromadb, fastapi, uvicorn are in requirements.txt)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the server script and the local chroma_data folder
# (In production, you'd want to mount an external volume instead of baking the data into the image)
COPY vectordb_server.py ./
COPY chroma_data ./chroma_data/

EXPOSE 8001

CMD ["uvicorn", "vectordb_server:app", "--host", "0.0.0.0", "--port", "8001"]
