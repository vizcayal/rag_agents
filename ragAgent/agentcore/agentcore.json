{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "ragAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "ragAgent"
  },
  "runtimes": [
    {
      "name": "MyAgent",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/MyAgent/",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        { "name": "KNOWLEDGE_BASE_ID", "value": "GPWL6TCSLD" },
        { "name": "AWS_REGION", "value": "us-east-1" }
      ],
      "policies": [
        {
          "actions": ["bedrock:Retrieve"],
          "resources": ["arn:aws:bedrock:us-east-1:911268715109:knowledge-base/GPWL6TCSLD"]
        }
      ],
      "instrumentation": {
        "enableOtel": false
      }
    }
  ],
  "memories": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "httpGateways": []
}